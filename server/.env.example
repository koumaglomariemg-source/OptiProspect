# Copiez ce fichier vers server/.env et remplissez les valeurs.
# server/.env est ignoré par git (ne committez jamais vos secrets).

# Secret JWT — obligatoire en production (générez un aléa : openssl rand -hex 32)
JWT_SECRET=

# Base de données MySQL/MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=optiprospect

# Port du serveur API (défaut 4000)
# PORT=4000

# Origines autorisées pour CORS, séparées par des virgules.
# Vide = même origine (le front est servi par le même serveur) ou toutes origines en dev.
# Exemple : CORS_ORIGIN=https://optiprospect.example.com,https://admin.optiprospect.example.com
CORS_ORIGIN=

# Création du premier compte admin (seulement si aucun admin n'existe en base).
# Sans ADMIN_PASSWORD, le compte admin@example.com / admin123 est créé (à changer au 1er login).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# SMTP pour l'envoi des identifiants par email (ex. Gmail).
# Pour Gmail : activez la "validation en 2 étapes" puis créez un "mot de passe d'application".
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=votre.email@gmail.com
#   SMTP_PASS=votre-mot-de-passe-d-application
#   SMTP_FROM=votre.email@gmail.com  (optionnel, défaut = SMTP_USER)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
